---
import { negocio, whatsappUrl } from '../lib/site';
const redes = Object.entries(negocio.redes ?? {}) as [string, string][];
const nombresRed: Record<string, string> = { instagram: 'Instagram', facebook: 'Facebook', tiktok: 'TikTok' };
const wa = whatsappUrl();
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor pie__fila">
    <div>
      <p class="pie__nombre">{negocio.nombre}</p>
      <p class="texto-suave">{negocio.direccion} · {negocio.ciudad}</p>
      {negocio.email && <p><a href={`mailto:${negocio.email}`}>{negocio.email}</a></p>}
    </div>
    {
      redes.length > 0 && (
        <ul class="pie__redes" aria-label="Redes sociales">
          {redes.map(([red, url]) => (
            <li>
              <a href={url} target="_blank" rel="noopener noreferrer">{nombresRed[red] ?? red}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="contenedor pie__legal">
    <p>© {anio} {negocio.nombre}{negocio.nit && <> · NIT {negocio.nit}</>}</p>
    <p><a href="/privacidad/">Política de tratamiento de datos</a> · Este sitio no usa cookies ni rastreadores.</p>
  </div>
</footer>

{
  wa && (
    <a class="wa-flotante" href={wa} target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp">
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
        <path
          fill="currentColor"
          d="M16 3C9 3 3.3 8.6 3.3 15.6c0 2.4.7 4.7 1.9 6.7L3 29l6.9-2.2c1.9 1 4 1.6 6.1 1.6 7 0 12.7-5.7 12.7-12.7S23 3 16 3zm0 23.1c-2 0-3.9-.6-5.5-1.6l-.4-.2-4.1 1.3 1.3-4-.3-.4a10.4 10.4 0 0 1-1.6-5.6c0-5.8 4.7-10.5 10.6-10.5s10.5 4.7 10.5 10.5S21.8 26.1 16 26.1zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.6-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6.3-.5c.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 .8.4 1.4.6 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"
        />
      </svg>
    </a>
  )
}
