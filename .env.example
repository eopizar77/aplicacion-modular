# Copia este archivo como .env y ajusta los valores. NUNCA subas .env al repositorio.

# Puerto del host (192.168.20.52) donde se expone el contenedor de sitios públicos hacia Nginx Proxy Manager
WEB_PORT=19085

# Puerto del host (192.168.20.52) donde se expone el panel visual Forja Studio
STUDIO_PORT=19086

# Clave de acceso a Forja Studio (recomendado en Proxmox/LAN; déjala vacía solo en pruebas locales 127.0.0.1)
STUDIO_TOKEN=

# Dominio base de tu Homelab (o dominio público): los sitios quedan en <slug>.<DOMINIO_BASE>
DOMINIO_BASE=homelab.lan

# Esquema de URL (http para homelab.lan con HTTP Only en NPM; https para Internet)
ESQUEMA_URL=http

# Mostrar la página índice interna en forja.homelab.lan (true en Homelab, false en Internet)
MOSTRAR_INDICE=true

# (Opcional) Token de Cloudflare Tunnel para publicar sin abrir puertos del router
# Se usa con: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# ----------------------------------------------------------------------------
# Integración Homelab IA (Proxmox 192.168.20.52 · 16 GB RAM · HDD 1TB + 2TB)
# ----------------------------------------------------------------------------
# Puente hacia tu stack deepseek_harness (auditoría de copy + Nivel 4 Dirección Cinematográfica)
DEEPSEEK_HARNESS_URL=http://192.168.20.52:3090
DEEPSEEK_API_KEY=

# Puente hacia tu instancia de n8n (automatización de webhooks audiovisuales Nivel 2/3/5)
N8N_WEBHOOK_URL=http://192.168.20.52:5678

# Puente hacia tu instancia de Qdrant (catálogo vectorial de plantillas, temas, escenas 3D e historial de auditorías)
QDRANT_URL=http://192.168.20.52:6333

# (Opcional) API Key gratuita de Google PageSpeed Insights para métricas LCP/CLS sin límite de cuota pública
PAGESPEED_API_KEY=

# Rutas opcionales en el host Linux para separar I/O entre el disco de 1TB y el de 2TB
# (Si se dejan como nombres de volumen, Docker gestiona los volúmenes automáticamente)
HDD_1TB_PATH=forja_sites
HDD_1TB_DB_PATH=forja_pgdata
HDD_2TB_PATH=forja_dist
POSTGRES_PASSWORD=

